{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "next dev"
    },
    "socket": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "api/socket-io.mts",
      "installCommand": "npm ci",
      "buildCommand": "npm run typecheck:server",
      "devCommand": "tsx api/socket-io.mts",
      "functions": {
        "api/socket-io.mts": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/socket-io/socket.io/(.*)",
      "destination": { "service": "socket" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
