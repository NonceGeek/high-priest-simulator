{
  "name": "high-priest-simulator-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts --dev",
    "dev:frontend": "next dev",
    "dev:socket": "tsx api/socket-io.mts",
    "build": "next build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/socketServer.integration.test.ts",
    "dev:vercel": "vercel dev --local",
    "lint": "next lint"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vercel": "^62.1.0"
  }
}
